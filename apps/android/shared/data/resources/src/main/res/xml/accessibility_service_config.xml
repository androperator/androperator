<?xml version="1.0" encoding="utf-8"?>
<!-- Both Operator variants request access to Android-marked sensitive hierarchies. -->
<accessibility-service
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:isAccessibilityTool="true"
    android:description="@string/accessibility_service_summary"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowsChanged|typeWindowContentChanged"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows|flagInputMethodEditor"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="5000"
    android:canRetrieveWindowContent="true"
    android:canPerformGestures="true"
    android:canRequestFilterKeyEvents="true"
    android:settingsActivity="androperator.activity.MainActivity"
  />
