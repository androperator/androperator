{
  "name": "@androperator/cli",
  "version": "1.1.0",
  "description": "Androperator Node API - reliable Android execution for LLM agents",
  "type": "module",
  "main": "dist/cli/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/androperator/androperator.git",
    "directory": "apps/node"
  },
  "homepage": "https://androperator.com",
  "bugs": "https://github.com/androperator/androperator/issues",
  "bin": {
    "androperator": "dist/cli/index.js"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "files": [
    "dist/",
    "!dist/test/**",
    "!dist/**/*.map",
    "README.md",
    "LICENSE",
    "bundled-skills/",
    "capture-helper/"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "start": "node dist/cli/index.js",
    "test": "node scripts/test.mjs",
    "test:unit": "node scripts/test.mjs --unit",
    "lint": "eslint src --ext .ts",
    "emulator:status": "node dist/adapters/android-emulator/status.js"
  },
  "keywords": [
    "androperator",
    "openclaw",
    "android",
    "automation",
    "agent"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.2",
    "@types/pngjs": "^6.0.5",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@androperator/emulator": "0.1.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "express": "^5.2.1",
    "pngjs": "^7.0.0",
    "saxes": "^6.0.0",
    "zod": "^3.25.0"
  }
}
