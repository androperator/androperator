<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <application android:label="Androperator media fixture" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- Debug fixture is protected by android.permission.DUMP. -->
        <!-- nosemgrep: exported_activity -->
        <activity android:name="androperator.operator.debug.MediaProofActivity"
            android:exported="true" android:permission="android.permission.DUMP" />
        <receiver android:name="androperator.operator.debug.MediaProofActivity$Control"
            android:exported="true" android:permission="android.permission.DUMP" />
    </application>
</manifest>
